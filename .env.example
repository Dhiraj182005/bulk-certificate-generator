# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

# PostgreSQL connection string used by the application and Alembic.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/certificates

# Optional: directory where generated certificate PDFs are stored.
# Defaults to generated_certificates/
# CERTIFICATE_OUTPUT_DIR=generated_certificates
